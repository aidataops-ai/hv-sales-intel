GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=
MS_SENDER_EMAIL=
EMAIL_REPLY_LOOKBACK_DAYS=30
NEXT_PUBLIC_RINGCENTRAL_WEB_APP_URL=https://app.ringcentral.com

# Salesforce (Apex REST endpoint with x-api-key auth)
SF_APEX_URL=
SF_API_KEY=

# Clay owner enrichment
CLAY_TABLE_WEBHOOK_URL=
CLAY_TABLE_API_KEY=
CLAY_INBOUND_SECRET=

# Job-posting leads (Instant Signals).
# LEAD_CRON_SECRET gates /api/cron/leads/*. Leave it empty and both stages
# return 503 — a background stage that spends model credits should not be
# reachable by omission. See docs/agents/lead-cron.md.
LEAD_CRON_SECRET=
QUALIFIER_MODEL=gpt-5.6-terra
QUALIFIER_REASONING_EFFORT=medium
QUALIFIER_BATCH_SIZE=20
LEAD_COLLECT_BATCH=40
LEAD_QUALIFY_BATCH=60
LEAD_COMPANY_ID=
# Manual "Run pipeline" button (admin, on /signals) dispatches the GitHub
# Actions workflow instead of running the sweep in-process. Needs a token with
# `actions: write` on the repo. Empty disables the retrigger endpoint (503).
GITHUB_TOKEN=
GITHUB_REPO=aidataops-ai/hv-sales-intel
GITHUB_LEADS_WORKFLOW=leads.yml
GITHUB_WORKFLOW_REF=main
